# --- Banco (Supabase > Connect > ORMs/Prisma) ---
# Pooled (Supavisor, modo transaction, porta 6543) — usada pela aplicação em runtime.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direta / session pooler (porta 5432) — usada pela CLI do Prisma (migrations, seed).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# --- Supabase (Connect > Framework: a "SUPABASE_URL" do projeto) ---
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# Chave publishable (sb_publishable_...) ou anon: a mesma do web/.env. É pública.
SUPABASE_PUBLISHABLE_KEY=""

# --- HTTP ---
# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGIN="http://localhost:5173"
PORT=3333
